/* =========================================================
   状態管理 (localStorage)
   ========================================================= */
const STORE_KEY = "kr1math_progress_v1";
const STREAK_KEY = "kr1math_streak_v1";

function safeLocalGet(key, fallback){
  try{
    const v = localStorage.getItem(key);
    return v === null ? fallback : v;
  }catch(e){ return fallback; }
}
function safeLocalSet(key, value){
  try{ localStorage.setItem(key, value); }catch(e){ /* storageが使えない環境では無視 */ }
}

function loadProgress(){
  try{
    const raw = safeLocalGet(STORE_KEY, null);
    return raw ? JSON.parse(raw) : {};
  }catch(e){ return {}; }
}
function saveProgress(p){
  safeLocalSet(STORE_KEY, JSON.stringify(p));
}
function getState(id){
  if(!progress[id]) progress[id] = {correct:0, wrong:0, streak:0, weak:false, w:5, lastSeen:0};
  return progress[id];
}

let progress = loadProgress();
let streak = parseInt(safeLocalGet(STREAK_KEY, "0"), 10);

/* =========================================================
   採点用の正規化
   ========================================================= */
function normalize(s){
  if(s===undefined || s===null) return "";
  s = s.toString();
  // 全角英数・記号(！～～:FF01-FF5E)を半角に変換。数字・x・括弧・ピリオド・スラッシュ・プラス・マイナス・イコールなどを網羅する
  s = s.replace(/[！-～]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xFEE0));
  // 上の範囲に入らない長音記号・マイナス記号のゆれも統一
  s = s.replace(/[ーー−‐]/g, "-");
  s = s.replace(/×/g, "*");
  s = s.replace(/÷/g, "/");
  s = s.replace(/²/g, "^2").replace(/³/g, "^3");
  s = s.replace(/\s+/g, "");
  return s.toLowerCase();
}
function isCorrect(input, answer){
  return normalize(input) === normalize(answer);
}

/* =========================================================
   出題範囲 & プール
   ========================================================= */
let currentRange = "all"; // "all" | 1 | 2 | 3 | "weak"
let currentLevel = "all"; // "all" | 1 | 2
const RANGE_LABELS = [
  {key:"all", label:"全範囲"},
  {key:1, label:"第1章"},
  {key:2, label:"第2章"},
  {key:3, label:"第3章"},
  {key:"weak", label:"弱点だけ"},
];
const LEVEL_LABELS = [
  {key:"all", label:"レベル:全部"},
  {key:1, label:"やさしい"},
  {key:2, label:"むずかしい"},
];

function getPool(){
  let pool;
  if(currentRange === "all") pool = QUESTIONS;
  else if(currentRange === "weak") pool = QUESTIONS.filter(q => getState(q.id).weak);
  else pool = QUESTIONS.filter(q => q.ch === currentRange);
  if(currentLevel !== "all") pool = pool.filter(q => q.lv === currentLevel);
  return pool;
}

function pickQuestion(excludeId){
  let pool = getPool();
  if(pool.length === 0) return null;
  if(pool.length > 1 && excludeId !== undefined){
    const filtered = pool.filter(q => q.id !== excludeId);
    if(filtered.length) pool = filtered;
  }
  const weights = pool.map(q => getState(q.id).w || 5);
  const total = weights.reduce((a,b)=>a+b, 0);
  let r = Math.random() * total;
  for(let i=0;i<pool.length;i++){
    r -= weights[i];
    if(r <= 0) return pool[i];
  }
  return pool[pool.length-1];
}


/* =========================================================
   フラッシュカード ロジック
   ========================================================= */
let curQ = null;
let lastQId = undefined;
let historyStack = []; // 直前まで表示していた問題idのスタック(「前の問題」用)
const HISTORY_MAX = 50;

const flashcardEl = document.getElementById("flashcard");
const qtextEl = document.getElementById("qtext");
const frontUnitEl = document.getElementById("frontUnit");
const inputAreaEl = document.getElementById("inputArea");
const resultBadgeEl = document.getElementById("resultBadge");
const backAnswerEl = document.getElementById("backAnswer");
const backStepsEl = document.getElementById("backSteps");
const selfGradeRowEl = document.getElementById("selfGradeRow");
const nextBtnEl = document.getElementById("nextBtn");
const backBtnEl = document.getElementById("backBtn");

function syncFlashHeight(selector){
  const face = flashcardEl.querySelector(selector);
  if(face) flashcardEl.style.height = face.scrollHeight + "px";
}

function updateBackBtnState(){
  backBtnEl.disabled = historyStack.length === 0;
}

// 問題qをフロント面に表示する(履歴操作はしない)
function showQuestionFront(q){
  flashcardEl.classList.remove("flipped");
  curQ = q;
  lastQId = q.id;
  frontUnitEl.textContent = CH_NAMES[q.ch].split(" ")[0] + "・" + q.sub;
  qtextEl.textContent = q.q;

  if(q.type === "in"){
    inputAreaEl.innerHTML = `
      <div class="input-row">
        <input type="text" id="ansInput" inputmode="none" readonly placeholder="${q.ph || '答えを入力'}" value="">
      </div>
      <div class="keypad" id="keypad"></div>
      <button class="btn block" id="checkBtn">答え合わせ</button>
      <div class="hint">わからないときは空のまま「答え合わせ」を押すと答えが見られます。</div>
    `;
    renderKeypad();
    document.getElementById("checkBtn").addEventListener("click", onCheckInput);
  }else{
    inputAreaEl.innerHTML = `<button class="btn block" id="revealBtn">答えを見る</button>`;
    document.getElementById("revealBtn").addEventListener("click", onReveal);
  }
  syncFlashHeight(".face.front");
}

function renderFront(){
  // 既に表示していた問題があれば履歴に積んでおく(「前の問題」で戻れるように)
  if(curQ){
    historyStack.push(curQ.id);
    if(historyStack.length > HISTORY_MAX) historyStack.shift();
  }
  const next = pickQuestion(lastQId);
  if(!next){
    flashcardEl.classList.remove("flipped");
    curQ = null;
    qtextEl.textContent = "この範囲には問題がありません。範囲を変えてみてください。";
    inputAreaEl.innerHTML = "";
    frontUnitEl.textContent = "-";
    syncFlashHeight(".face.front");
    updateBackBtnState();
    return;
  }
  showQuestionFront(next);
  updateBackBtnState();
}

function goToPrevQuestion(){
  if(historyStack.length === 0) return;
  const prevId = historyStack.pop();
  const q = QUESTIONS.find(qq => qq.id === prevId);
  updateBackBtnState();
  if(!q) return;
  showQuestionFront(q);
}

backBtnEl.addEventListener("click", goToPrevQuestion);


const KEYPAD_KEYS = [
  ["(",")","x","⌫"],
  ["7","8","9","/"],
  ["4","5","6","-"],
  ["1","2","3","+"],
  ["0",".","=","C"],
];
function renderKeypad(){
  const wrap = document.getElementById("keypad");
  if(!wrap) return;
  wrap.innerHTML = "";
  KEYPAD_KEYS.flat().forEach(k=>{
    const b = document.createElement("button");
    b.className = "key" + ((k==="⌫"||k==="C") ? " fn" : "");
    b.type = "button";
    b.textContent = k;
    b.addEventListener("click", ()=> handleKeyTap(k));
    wrap.appendChild(b);
  });
}
function handleKeyTap(k){
  const input = document.getElementById("ansInput");
  if(!input) return;
  if(k === "⌫") input.value = input.value.slice(0, -1);
  else if(k === "C") input.value = "";
  else input.value += k;
}

function onCheckInput(){
  const val = document.getElementById("ansInput").value;
  const ok = val.trim() !== "" && isCorrect(val, curQ.a);
  showBack(ok, ok ? null : true); // 自動採点。不正解時は自己上書きボタンも出す
}

function onReveal(){
  // reveal型は必ず自己採点モードで開く
  showBack(null, true);
}

function showBack(autoResult, allowSelfGrade){
  backAnswerEl.textContent = curQ.a;
  backStepsEl.textContent = curQ.steps;

  if(autoResult === true){
    resultBadgeEl.textContent = "○ 正解!";
    resultBadgeEl.className = "result-badge ok";
    selfGradeRowEl.style.display = "none";
    applyResult(true);
  }else if(autoResult === false){
    resultBadgeEl.textContent = "✕ ちがう答え";
    resultBadgeEl.className = "result-badge ng";
    selfGradeRowEl.style.display = "flex";
    applyResult(false);
  }else{
    resultBadgeEl.textContent = "👀 答えを確認しよう";
    resultBadgeEl.className = "result-badge ok";
    selfGradeRowEl.style.display = "flex";
  }
  syncFlashHeight(".face.back");
  flashcardEl.classList.add("flipped");
}

document.getElementById("selfOk").addEventListener("click", ()=>{
  resultBadgeEl.textContent = "○ 正解!";
  resultBadgeEl.className = "result-badge ok";
  selfGradeRowEl.style.display = "none";
  applyResult(true, true);
  syncFlashHeight(".face.back");
});
document.getElementById("selfNg").addEventListener("click", ()=>{
  resultBadgeEl.textContent = "✕ 不正解";
  resultBadgeEl.className = "result-badge ng";
  selfGradeRowEl.style.display = "none";
  applyResult(false, true);
  syncFlashHeight(".face.back");
});

function applyResult(correct, isOverride){
  const st = getState(curQ.id);
  st.lastSeen = Date.now();
  if(correct){
    st.correct += 1;
    st.streak += 1;
    if(st.streak >= 3) st.weak = false;
    st.w = Math.max(1, 5 - st.streak);
    streak += 1;
  }else{
    st.wrong += 1;
    st.streak = 0;
    st.weak = true;
    st.w = 8;
    streak = 0;
  }
  progress[curQ.id] = st;
  saveProgress(progress);
  safeLocalSet(STREAK_KEY, streak.toString());
  updateStreakBadge();
  updateWeakCount();
}

nextBtnEl.addEventListener("click", renderFront);

function updateStreakBadge(){
  document.getElementById("streakNum").textContent = streak;
}

/* =========================================================
   範囲チップ
   ========================================================= */
function renderRangeChips(){
  const wrap = document.getElementById("rangeChips");
  wrap.innerHTML = "";
  RANGE_LABELS.forEach(r=>{
    const b = document.createElement("button");
    b.className = "chip" + (currentRange===r.key ? " active":"") + (r.key==="weak" ? " weak":"");
    b.textContent = r.label;
    b.addEventListener("click", ()=>{
      currentRange = r.key;
      renderRangeChips();
      lastQId = undefined;
      historyStack = [];
      updateBackBtnState();
      renderFront();
    });
    wrap.appendChild(b);
  });
}

function renderLevelChips(){
  const wrap = document.getElementById("levelChips");
  wrap.innerHTML = "";
  LEVEL_LABELS.forEach(lv=>{
    const b = document.createElement("button");
    b.className = "chip" + (currentLevel===lv.key ? " active":"");
    b.textContent = lv.label;
    b.addEventListener("click", ()=>{
      currentLevel = lv.key;
      renderLevelChips();
      lastQId = undefined;
      historyStack = [];
      updateBackBtnState();
      renderFront();
    });
    wrap.appendChild(b);
  });
}

/* =========================================================
   タブ切り替え
   ========================================================= */
const tabButtons = document.querySelectorAll("nav.tabs button");
tabButtons.forEach(btn=>{
  btn.addEventListener("click", ()=>{
    tabButtons.forEach(b=>b.classList.remove("active"));
    btn.classList.add("active");
    document.querySelectorAll("main").forEach(m=>m.classList.remove("show"));
    const target = document.getElementById("tab-"+btn.dataset.tab);
    target.classList.add("show");
    if(btn.dataset.tab === "review") renderReview();
    if(btn.dataset.tab === "dash") renderDashboard();
  });
});

/* =========================================================
   復習リスト
   ========================================================= */
function renderReview(){
  const weakQs = QUESTIONS.filter(q => getState(q.id).weak);
  const startWrap = document.getElementById("reviewStartWrap");
  const listWrap = document.getElementById("reviewList");

  if(weakQs.length === 0){
    startWrap.innerHTML = "";
    listWrap.innerHTML = `<div class="empty"><span class="emoji">🎉</span>今のところ弱点はありません。<br>フラッシュ問題に挑戦してみよう!</div>`;
    return;
  }

  startWrap.innerHTML = `
    <div class="card" style="margin-bottom:16px;">
      <div style="font-weight:700; margin-bottom:6px;">弱点ストック: ${weakQs.length}問</div>
      <div style="font-size:13px; color:var(--ink-soft); margin-bottom:10px;">間違えた問題だけを集中して練習できます。</div>
      <button class="btn green block" id="startWeakBtn">復習フラッシュを始める</button>
    </div>
  `;
  document.getElementById("startWeakBtn").addEventListener("click", ()=>{
    currentRange = "weak";
    currentLevel = "all";
    renderRangeChips();
    renderLevelChips();
    document.querySelector('nav.tabs button[data-tab="flash"]').click();
    lastQId = undefined;
    historyStack = [];
    updateBackBtnState();
    renderFront();
  });

  listWrap.innerHTML = "";
  // 章ごとにまとめる
  [1,2,3].forEach(ch=>{
    const chQs = weakQs.filter(q=>q.ch===ch);
    if(chQs.length===0) return;
    const label = document.createElement("div");
    label.className = "section-label";
    label.textContent = CH_NAMES[ch];
    listWrap.appendChild(label);
    chQs.forEach(q=>{
      const st = getState(q.id);
      const item = document.createElement("div");
      item.className = "review-item";
      item.innerHTML = `
        <div class="rtop">
          <div>
            <div class="runit">${q.sub}</div>
            <div class="rq">${q.q.replace(/\n/g,"<br>")}</div>
          </div>
          <div class="rwrong">✕${st.wrong}回</div>
        </div>
        <button class="rtoggle">答えを見る</button>
        <div class="ranswer">
          <strong>答え: ${q.a}</strong><br>${q.steps}
        </div>
      `;
      const toggle = item.querySelector(".rtoggle");
      const ans = item.querySelector(".ranswer");
      toggle.addEventListener("click", ()=>{
        ans.classList.toggle("open");
        toggle.textContent = ans.classList.contains("open") ? "答えを閉じる" : "答えを見る";
      });
      listWrap.appendChild(item);
    });
  });
}

function updateWeakCount(){
  const n = QUESTIONS.filter(q => getState(q.id).weak).length;
  const badge = document.getElementById("weakCount");
  if(n > 0){ badge.style.display = "inline-block"; badge.textContent = n; }
  else{ badge.style.display = "none"; }
}

/* =========================================================
   進捗ダッシュボード
   ========================================================= */
function renderDashboard(){
  let totalAnswered=0, totalCorrect=0, totalMastered=0;
  QUESTIONS.forEach(q=>{
    const st = getState(q.id);
    if(st.correct + st.wrong > 0) totalAnswered++;
    totalCorrect += st.correct;
    if(st.streak >= 3) totalMastered++;
  });
  let totalTries=0;
  QUESTIONS.forEach(q=>{ const st=getState(q.id); totalTries += st.correct+st.wrong; });

  document.getElementById("statTotal").textContent = totalTries;
  document.getElementById("statAcc").textContent = totalTries>0 ? Math.round(totalCorrect/totalTries*100)+"%" : "0%";
  document.getElementById("statMastered").textContent = totalMastered + "/" + QUESTIONS.length;

  const wrap = document.getElementById("chapterBars");
  wrap.innerHTML = "";
  [1,2,3].forEach(ch=>{
    const qs = QUESTIONS.filter(q=>q.ch===ch);
    const mastered = qs.filter(q=>getState(q.id).streak>=3).length;
    const pct = Math.round(mastered/qs.length*100);
    const subs = [...new Set(qs.map(q=>q.sub))];

    const card = document.createElement("div");
    card.className = "ch-card";
    let subHtml = "";
    subs.forEach(sub=>{
      const subQs = qs.filter(q=>q.sub===sub);
      const weakInSub = subQs.filter(q=>getState(q.id).weak).length;
      const masteredInSub = subQs.filter(q=>getState(q.id).streak>=3).length;
      subHtml += `<div class="subrow"><span>${sub}</span><span>${masteredInSub>0?`習得${masteredInSub}/${subQs.length}`:""}${weakInSub>0?` <span class="tag-weak">弱点${weakInSub}</span>`:""}</span></div>`;
    });

    card.innerHTML = `
      <div class="head"><span class="name">${CH_NAMES[ch]}</span><span class="pct">${pct}%</span></div>
      <div class="bar"><div style="width:${pct}%;"></div></div>
      ${subHtml}
    `;
    wrap.appendChild(card);
  });
}

/* =========================================================
   設定
   ========================================================= */
const resetConfirmEl = document.getElementById("resetConfirm");

document.getElementById("resetBtn").addEventListener("click", ()=>{
  resetConfirmEl.style.display = "block";
});
document.getElementById("resetCancelBtn").addEventListener("click", ()=>{
  resetConfirmEl.style.display = "none";
});
document.getElementById("resetConfirmBtn").addEventListener("click", ()=>{
  progress = {};
  streak = 0;
  saveProgress(progress);
  safeLocalSet(STREAK_KEY, "0");
  updateStreakBadge();
  updateWeakCount();
  lastQId = undefined;
  currentRange = "all";
  currentLevel = "all";
  historyStack = [];
  updateBackBtnState();
  renderRangeChips();
  renderLevelChips();
  renderFront();

  resetConfirmEl.innerHTML = '<div style="font-size:13px; color:var(--ink-soft); font-weight:700;">✅ リセットしました。</div>';
  setTimeout(()=>{ resetConfirmEl.style.display = "none"; }, 1600);
});
document.getElementById("totalQCount").textContent = QUESTIONS.length + " 問";


/* =========================================================
   テーマ切り替え
   ========================================================= */
const THEME_KEY = "kr1math_theme_v1";
const themeBtn = document.getElementById("themeBtn");
function applyTheme(theme){
  if(theme === "light"){
    document.body.setAttribute("data-theme", "light");
    themeBtn.textContent = "☀️ ライト";
  }else{
    document.body.removeAttribute("data-theme");
    themeBtn.textContent = "🌙 ダーク";
  }
}
let savedTheme = safeLocalGet(THEME_KEY, "dark");
applyTheme(savedTheme);
themeBtn.addEventListener("click", ()=>{
  savedTheme = (savedTheme === "dark") ? "light" : "dark";
  safeLocalSet(THEME_KEY, savedTheme);
  applyTheme(savedTheme);
});

/* =========================================================
   初期化
   ========================================================= */
renderRangeChips();
renderLevelChips();
renderFront();
updateStreakBadge();
updateWeakCount();

window.addEventListener("resize", ()=>{
  syncFlashHeight(flashcardEl.classList.contains("flipped") ? ".face.back" : ".face.front");
});
</script>
