<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>中1数学 1学期マスター(啓林館対応)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Kaisei+Decol:wght@500;700&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
:root{
  /* ダークモード(黒板風)をデフォルトに */
  --bg:#1B2420;
  --paper-line:rgba(255,255,255,0.035);
  --ink:#F2F1EA;
  --ink-soft:#9AA79C;
  --green:#7FD9A8;
  --green-soft:rgba(127,217,168,0.16);
  --coral:#FF9466;
  --coral-soft:rgba(255,148,102,0.16);
  --yellow:#F5D76E;
  --yellow-soft:rgba(245,215,110,0.16);
  --line:rgba(255,255,255,0.12);
  --card:#222E28;
  --header-bg:rgba(27,36,32,0.88);
  --radius:18px;
  --shadow: 0 2px 0 rgba(0,0,0,0.25), 0 8px 24px rgba(0,0,0,0.45);
}
body[data-theme="light"]{
  --bg:#FAF7F0;
  --paper-line:#E9E3D4;
  --ink:#1F2A44;
  --ink-soft:#6B7184;
  --green:#2F6B4F;
  --green-soft:#DCEEE3;
  --coral:#E2622F;
  --coral-soft:#FBE3D7;
  --yellow:#E3A92B;
  --yellow-soft:#FCF0CE;
  --line:#E4DFD3;
  --card:#FFFFFF;
  --header-bg:rgba(250,247,240,0.92);
  --shadow: 0 2px 0 rgba(31,42,68,0.04), 0 8px 24px rgba(31,42,68,0.07);
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:var(--bg);
  background-image: repeating-linear-gradient(
      to bottom,
      transparent 0px,
      transparent 27px,
      var(--paper-line) 28px
  );
  color:var(--ink);
  font-family:"Zen Kaku Gothic New", "Hiragino Sans", sans-serif;
  -webkit-font-smoothing:antialiased;
  min-height:100vh;
  padding-bottom:84px;
}
.display{font-family:"Kaisei Decol", serif;}
a,button{font-family:inherit;}
button{cursor:pointer;}
.app{max-width:520px;margin:0 auto;padding:0 16px;}

/* ---------- Header ---------- */
header.top{
  position:sticky; top:0; z-index:20;
  background:var(--header-bg);
  backdrop-filter: blur(6px);
  border-bottom:1px solid var(--line);
}
.top-inner{
  max-width:520px;margin:0 auto;padding:14px 16px 10px;
  display:flex;align-items:center;justify-content:space-between;
}
.brand{display:flex;flex-direction:column;gap:1px;}
.brand .title{font-family:"Kaisei Decol",serif;font-size:17px;font-weight:700;letter-spacing:.02em;}
.brand .sub{font-size:11px;color:var(--ink-soft);}
.streak-badge{
  display:flex;align-items:center;gap:6px;
  background:var(--card);border:1px solid var(--line);
  border-radius:999px;padding:6px 12px;font-size:13px;font-weight:700;
  box-shadow:var(--shadow);
  white-space:nowrap;
}
.streak-badge .flame{font-size:15px;}

/* ---------- Nav ---------- */
nav.tabs{
  display:flex;gap:8px;margin:14px 0 18px;
}
nav.tabs button{
  flex:1; border:1px solid var(--line); background:var(--card);
  border-radius:14px; padding:9px 4px; font-size:12.5px; font-weight:700;
  color:var(--ink-soft);
  display:flex;flex-direction:column;align-items:center;gap:2px;
  transition:.15s;
}
nav.tabs button .ico{font-size:16px;}
nav.tabs button.active{
  background:var(--ink); color:#fff; border-color:var(--ink);
}
nav.tabs button .count{
  font-size:10px; background:var(--coral); color:#fff; border-radius:999px;
  padding:0 6px; position:relative; top:-1px;
}
nav.tabs button.active .count{background:#fff;color:var(--coral);}

main{display:none;}
main.show{display:block; animation:fadein .25s ease;}
@keyframes fadein{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:translateY(0);}}

/* ---------- Cards / generic ---------- */
.card{
  background:var(--card); border:1px solid var(--line); border-radius:var(--radius);
  box-shadow:var(--shadow); padding:18px;
}
.section-label{
  font-size:11.5px; font-weight:700; color:var(--ink-soft);
  letter-spacing:.06em; text-transform:uppercase; margin:22px 2px 8px;
}
.section-label:first-of-type{margin-top:4px;}

/* ---------- Range select ---------- */
.chip-row{display:flex; flex-wrap:wrap; gap:8px; margin-bottom:14px;}
.chip{
  border:1px solid var(--line); background:var(--card); color:var(--ink-soft);
  border-radius:999px; padding:7px 13px; font-size:12.5px; font-weight:700;
}
.chip.active{background:var(--green); border-color:var(--green); color:#fff;}
.chip.weak.active{background:var(--coral); border-color:var(--coral);}

/* ---------- Flash toolbar ---------- */
.flash-toolbar{display:flex; justify-content:flex-start; margin-bottom:8px;}
.btn.small{padding:8px 14px; font-size:12.5px;}

/* ---------- Flash card ---------- */
.flash-wrap{ perspective:1400px; margin-top:6px;}
.flashcard{
  position:relative; min-height:120px;
  transform-style:preserve-3d;
  transition:transform .5s cubic-bezier(.4,.2,.2,1), height .25s ease;
}
.flashcard.flipped{transform:rotateY(180deg);}
.face{
  position:absolute; top:0; left:0; width:100%; backface-visibility:hidden;
  border-radius:var(--radius); border:1px solid var(--line);
  background:var(--card); box-shadow:var(--shadow);
  padding:22px 20px; display:flex; flex-direction:column;
}
.face.back{transform:rotateY(180deg);}
.unit-tag{
  display:inline-block; align-self:flex-start;
  background:var(--green-soft); color:var(--green); font-weight:700;
  font-size:11.5px; padding:4px 10px; border-radius:999px; margin-bottom:12px;
}
.qtext{
  font-size:18.5px; line-height:1.65; font-weight:500; flex:1;
  white-space:pre-wrap;
}
.input-row{display:flex; gap:8px; margin-top:14px;}
.input-row input{
  flex:1; border:1.5px solid var(--line); border-radius:12px; padding:12px 14px;
  font-size:17px; font-weight:700; font-family:inherit; background:var(--bg); color:var(--ink);
  letter-spacing:.02em;
}
.input-row input:focus{outline:none; border-color:var(--green);}
.input-row input::placeholder{font-weight:400; color:var(--ink-soft); opacity:.7;}
.keypad{
  display:grid; grid-template-columns:repeat(4,1fr); gap:7px; margin-top:10px;
}
.keypad .key{
  border:1px solid var(--line); background:var(--card); color:var(--ink);
  border-radius:11px; padding:13px 0; font-size:17px; font-weight:700;
  font-family:inherit; transition:.1s;
}
.keypad .key:active{transform:scale(.94); background:var(--green-soft);}
.keypad .key.fn{color:var(--coral); font-size:14px;}
.btn{
  border:none; border-radius:12px; padding:12px 18px; font-size:14.5px; font-weight:700;
  color:#fff; background:var(--ink);
}
.btn.block{width:100%; margin-top:12px;}
.btn.green{background:var(--green);}
.btn.coral{background:var(--coral);}
.btn.ghost{background:var(--card); color:var(--ink); border:1.5px solid var(--line);}
.btn:disabled{opacity:.45;}
.hint{font-size:12px; color:var(--ink-soft); margin-top:6px;}

.back .result-badge{
  font-weight:900; font-size:15px; padding:6px 14px; border-radius:999px;
  display:inline-flex; align-items:center; gap:6px; align-self:flex-start; margin-bottom:10px;
}
.result-badge.ok{background:var(--green-soft); color:var(--green);}
.result-badge.ng{background:var(--coral-soft); color:var(--coral);}
.answer-line{font-size:17px; font-weight:700; margin-bottom:10px;}
.answer-line .lab{font-size:11.5px; color:var(--ink-soft); font-weight:700; display:block; margin-bottom:2px;}
.steps{
  background:var(--bg); border:1px dashed var(--line); border-radius:12px;
  padding:12px 13px; font-size:13.5px; color:var(--ink); line-height:1.6; white-space:pre-wrap;
}
.steps .lab{font-size:11.5px; color:var(--ink-soft); font-weight:700; display:block; margin-bottom:4px;}
.btnrow{display:flex; gap:8px; margin-top:12px;}
.btnrow .btn{flex:1;}

/* ---------- Dashboard ---------- */
.stat-grid{display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px; margin-bottom:18px;}
.stat-box{
  background:var(--card); border:1px solid var(--line); border-radius:14px; padding:12px 8px;
  text-align:center;
}
.stat-box .num{font-family:"Kaisei Decol",serif; font-size:22px; font-weight:700;}
.stat-box .lab{font-size:10.5px; color:var(--ink-soft); margin-top:2px;}

.ch-card{
  background:var(--card); border:1px solid var(--line); border-radius:16px;
  padding:14px 16px; margin-bottom:10px;
}
.ch-card .head{display:flex; justify-content:space-between; align-items:baseline; margin-bottom:4px;}
.ch-card .head .name{font-weight:700; font-size:14.5px;}
.ch-card .head .pct{font-size:13px; color:var(--ink-soft); font-weight:700;}
.bar{height:8px; border-radius:999px; background:var(--line); overflow:hidden; margin-bottom:8px;}
.bar > div{height:100%; background:var(--green); border-radius:999px; transition:width .4s;}
.subrow{display:flex; justify-content:space-between; font-size:12px; color:var(--ink-soft); padding:3px 0;}
.subrow .tag-weak{color:var(--coral); font-weight:700;}

/* ---------- Review list ---------- */
.review-item{
  background:var(--card); border:1px solid var(--line); border-radius:14px;
  padding:13px 14px; margin-bottom:9px;
}
.review-item .rtop{display:flex; justify-content:space-between; align-items:flex-start; gap:8px;}
.review-item .runit{font-size:11px; color:var(--green); font-weight:700;}
.review-item .rq{font-size:14.5px; margin-top:3px; line-height:1.55;}
.review-item .rwrong{font-size:11px; color:var(--coral); font-weight:700; white-space:nowrap;}
.review-item .ranswer{
  margin-top:8px; font-size:13px; background:var(--bg); border-radius:10px; padding:9px 11px; display:none;
}
.review-item .ranswer.open{display:block;}
.review-item .rtoggle{font-size:12px; color:var(--ink-soft); margin-top:6px; text-decoration:underline; background:none; border:none; padding:0;}

.empty{
  text-align:center; padding:50px 20px; color:var(--ink-soft);
}
.empty .emoji{font-size:34px; display:block; margin-bottom:10px;}

/* ---------- Settings ---------- */
.set-row{
  display:flex; justify-content:space-between; align-items:center;
  padding:13px 0; border-bottom:1px solid var(--line);
}
.set-row:last-child{border-bottom:none;}
.set-row .t{font-size:14px; font-weight:700;}
.set-row .d{font-size:12px; color:var(--ink-soft); margin-top:2px;}

footer.note{
  text-align:center; font-size:11px; color:var(--ink-soft); margin:26px 0 10px;
}
</style>
</head>
<body>
<header class="top">
  <div class="top-inner">
    <div class="brand">
      <div class="title display">1学期マスター</div>
      <div class="sub">中1数学・啓林館対応</div>
    </div>
    <div class="streak-badge"><span class="flame">🔥</span><span id="streakNum">0</span></div>
  </div>
</header>

<div class="app">
  <nav class="tabs">
    <button data-tab="flash" class="active"><span class="ico">⚡</span>フラッシュ</button>
    <button data-tab="review"><span class="ico">📌</span>復習リスト<span class="count" id="weakCount" style="display:none;">0</span></button>
    <button data-tab="dash"><span class="ico">📊</span>進捗</button>
    <button data-tab="set"><span class="ico">⚙️</span>設定</button>
  </nav>

  <!-- FLASH TAB -->
  <main id="tab-flash" class="show">
    <div class="chip-row" id="rangeChips"></div>
    <div class="chip-row" id="levelChips"></div>

    <div class="flash-toolbar">
      <button class="btn ghost small" id="backBtn" disabled>← 前の問題</button>
    </div>

    <div class="flash-wrap">
      <div class="flashcard" id="flashcard">
        <div class="face front">
          <span class="unit-tag" id="frontUnit">第1章</span>
          <div class="qtext" id="qtext">読み込み中...</div>
          <div id="inputArea"></div>
        </div>
        <div class="face back">
          <span class="result-badge" id="resultBadge">○ 正解</span>
          <div class="answer-line"><span class="lab">正しい答え</span><span id="backAnswer"></span></div>
          <div class="steps"><span class="lab">解き方</span><span id="backSteps"></span></div>
          <div class="btnrow" id="selfGradeRow" style="display:none;">
            <button class="btn coral" id="selfNg">✕ 不正解だった</button>
            <button class="btn green" id="selfOk">○ 正解だった</button>
          </div>
          <button class="btn block" id="nextBtn">次の問題 →</button>
        </div>
      </div>
    </div>
  </main>

  <!-- REVIEW TAB -->
  <main id="tab-review">
    <div id="reviewStartWrap"></div>
    <div id="reviewList"></div>
  </main>

  <!-- DASHBOARD TAB -->
  <main id="tab-dash">
    <div class="stat-grid">
      <div class="stat-box"><div class="num" id="statTotal">0</div><div class="lab">解いた問題数</div></div>
      <div class="stat-box"><div class="num" id="statAcc">0%</div><div class="lab">正解率</div></div>
      <div class="stat-box"><div class="num" id="statMastered">0</div><div class="lab">習得済み</div></div>
    </div>
    <div class="section-label">章ごとの定着度</div>
    <div id="chapterBars"></div>
  </main>

  <!-- SETTINGS TAB -->
  <main id="tab-set">
    <div class="card">
      <div class="set-row">
        <div>
          <div class="t">テーマ</div>
          <div class="d">ダークモード(黒板風)/ライトモード(ノート風)</div>
        </div>
        <button class="btn ghost" id="themeBtn">🌙 ダーク</button>
      </div>
      <div class="set-row" style="flex-direction:column; align-items:stretch;">
        <div style="display:flex; justify-content:space-between; align-items:center; width:100%;">
          <div>
            <div class="t">学習データをリセット</div>
            <div class="d">進捗・復習リスト・連続正解数をすべて消去します</div>
          </div>
          <button class="btn coral" id="resetBtn">リセット</button>
        </div>
        <div id="resetConfirm" style="display:none; margin-top:12px; padding:12px; border:1px dashed var(--line); border-radius:12px; background:var(--bg);">
          <div style="font-size:13px; color:var(--ink-soft); margin-bottom:10px;">本当に学習データをすべて消去しますか?この操作は取り消せません。</div>
          <div style="display:flex; gap:8px;">
            <button class="btn ghost" id="resetCancelBtn" style="flex:1;">キャンセル</button>
            <button class="btn coral" id="resetConfirmBtn" style="flex:1;">消去する</button>
          </div>
        </div>
      </div>
      <div class="set-row">
        <div>
          <div class="t">対応教科書</div>
          <div class="d">啓林館「未来へひろがる数学1」</div>
        </div>
      </div>
      <div class="set-row">
        <div>
          <div class="t">出題範囲</div>
          <div class="d">第1章 正の数・負の数／第2章 文字と式／第3章 方程式(入り口)</div>
        </div>
      </div>
      <div class="set-row">
        <div>
          <div class="t">収録問題数</div>
          <div class="d" id="totalQCount">- 問</div>
        </div>
      </div>
    </div>
    <footer class="note">データはこの端末のブラウザ内のみに保存されます。</footer>
  </main>
</div>

<script>
/* =========================================================
   問題データ
   type: "in"  = 入力して自動採点
         "rv"  = カードを開いて自分で○✕を判定
   ========================================================= */
const QUESTIONS = [
// ---------- 第1章 1. 正の数・負の数の意味 ----------
{id:101, ch:1, lv:1, sub:"数の大小・絶対値", type:"in", q:"-7 の絶対値を答えなさい。", a:"7", ph:"数値を入力(マイナスは-を使う)", steps:"絶対値とは、数直線上で0からその数までの距離のこと。-7と0の距離は7だから、絶対値は7。"},
{id:102, ch:1, lv:2, sub:"数の大小・絶対値", type:"in", q:"絶対値が4である数のうち、負の数を答えなさい。", a:"-4", ph:"数値を入力(マイナスは-を使う)", steps:"絶対値が4になる数は+4と-4の2つ。負の数なので-4。"},
{id:103, ch:1, lv:2, sub:"数の大小・絶対値", type:"in", q:"次の数の中で最も小さい数を答えなさい。\n-3, 5, -8, 2", a:"-8", ph:"数値を入力(マイナスは-を使う)", steps:"負の数は絶対値が大きいほど小さい数になる。-3と-8を比べると、絶対値が大きい-8の方が小さい。"},
{id:104, ch:1, lv:2, sub:"数の大小・絶対値", type:"in", q:"次の数の中で最も大きい数を答えなさい。\n-1, -6, 0, -4", a:"0", ph:"数値を入力(マイナスは-を使う)", steps:"0はどんな負の数よりも大きい。よって最大は0。"},
{id:105, ch:1, lv:1, sub:"数の大小・絶対値", type:"in", q:"-2 と -9 のうち、大きい方の数を答えなさい。", a:"-2", ph:"数値を入力(マイナスは-を使う)", steps:"負の数では、絶対値が小さい方が大きい数。2<9なので-2の方が大きい。"},
{id:106, ch:1, lv:1, sub:"数の大小・絶対値", type:"in", q:"0 より 5 小さい数を答えなさい。", a:"-5", ph:"数値を入力(マイナスは-を使う)", steps:"0から5小さい数は0-5=-5。"},
{id:107, ch:1, lv:2, sub:"数の大小・絶対値", type:"in", q:"絶対値が最も大きい数を選びなさい。\n3, -7, 5, -4", a:"-7", ph:"数値を入力(マイナスは-を使う)", steps:"それぞれの絶対値は3,7,5,4。最大は7なので、答えは-7。"},
{id:108, ch:1, lv:1, sub:"数の大小・絶対値", type:"in", q:"-3.5 の絶対値を答えなさい。", a:"3.5", ph:"数値を入力(マイナスは-を使う)", steps:"0から-3.5までの距離なので3.5。"},

// ---------- 第1章 2. 加法と減法 ----------
{id:111, ch:1, lv:1, sub:"加法と減法", type:"in", q:"(+3)+(+5) を計算しなさい。", a:"8", ph:"数値を入力(マイナスは-を使う)", steps:"同符号(+と+)の加法は、絶対値の和に共通の符号をつける。3+5=8、符号は+なので8。"},
{id:112, ch:1, lv:1, sub:"加法と減法", type:"in", q:"(-4)+(-7) を計算しなさい。", a:"-11", ph:"数値を入力(マイナスは-を使う)", steps:"同符号の加法。4+7=11、符号は-なので-11。"},
{id:113, ch:1, lv:1, sub:"加法と減法", type:"in", q:"(+6)+(-9) を計算しなさい。", a:"-3", ph:"数値を入力(マイナスは-を使う)", steps:"異符号の加法は、絶対値の差(大きい方-小さい方)に絶対値が大きい方の符号をつける。9-6=3、絶対値が大きいのは-9なので-3。"},
{id:114, ch:1, lv:1, sub:"加法と減法", type:"in", q:"(-5)+(+8) を計算しなさい。", a:"3", ph:"数値を入力(マイナスは-を使う)", steps:"異符号の加法。8-5=3、絶対値が大きいのは+8なので+3。"},
{id:115, ch:1, lv:1, sub:"加法と減法", type:"in", q:"(+4)-(+9) を計算しなさい。", a:"-5", ph:"数値を入力(マイナスは-を使う)", steps:"減法は引く数の符号を変えて加法に直す。(+4)-(+9)=(+4)+(-9)=-5。"},
{id:116, ch:1, lv:2, sub:"加法と減法", type:"in", q:"(-3)-(-7) を計算しなさい。", a:"4", ph:"数値を入力(マイナスは-を使う)", steps:"引く数の符号を変えて加法に直す。(-3)-(-7)=(-3)+(+7)=4。"},
{id:117, ch:1, lv:1, sub:"加法と減法", type:"in", q:"(-6)-(+2) を計算しなさい。", a:"-8", ph:"数値を入力(マイナスは-を使う)", steps:"(-6)-(+2)=(-6)+(-2)=-8。"},
{id:118, ch:1, lv:2, sub:"加法と減法", type:"in", q:"(+7)-(-3) を計算しなさい。", a:"10", ph:"数値を入力(マイナスは-を使う)", steps:"(+7)-(-3)=(+7)+(+3)=10。"},
{id:119, ch:1, lv:2, sub:"加法と減法", type:"in", q:"-8+5-3 を計算しなさい。", a:"-6", ph:"数値を入力(マイナスは-を使う)", steps:"左から順に計算する。-8+5=-3、-3-3=-6。"},
{id:120, ch:1, lv:2, sub:"加法と減法", type:"in", q:"3-(-4)+(-9) を計算しなさい。", a:"-2", ph:"数値を入力(マイナスは-を使う)", steps:"3-(-4)=3+4=7、7+(-9)=-2。"},

// ---------- 第1章 3. 乗法と除法 ----------
{id:121, ch:1, lv:1, sub:"乗法と除法", type:"in", q:"(-3)×(+4) を計算しなさい。", a:"-12", ph:"数値を入力(マイナスは-を使う)", steps:"異符号どうしの積は負になる。3×4=12なので-12。"},
{id:122, ch:1, lv:1, sub:"乗法と除法", type:"in", q:"(-6)×(-7) を計算しなさい。", a:"42", ph:"数値を入力(マイナスは-を使う)", steps:"同符号どうしの積は正になる。6×7=42。"},
{id:123, ch:1, lv:1, sub:"乗法と除法", type:"in", q:"(+8)÷(-2) を計算しなさい。", a:"-4", ph:"数値を入力(マイナスは-を使う)", steps:"異符号どうしの商は負になる。8÷2=4なので-4。"},
{id:124, ch:1, lv:1, sub:"乗法と除法", type:"in", q:"(-15)÷(-3) を計算しなさい。", a:"5", ph:"数値を入力(マイナスは-を使う)", steps:"同符号どうしの商は正になる。15÷3=5。"},
{id:125, ch:1, lv:2, sub:"乗法と除法", type:"rv", q:"(-2)の3乗 を計算しなさい。", a:"-8", steps:"(-2)×(-2)×(-2)=4×(-2)=-8。負の数の奇数回の積は負になる。"},
{id:126, ch:1, lv:1, sub:"乗法と除法", type:"rv", q:"(-2)の2乗 を計算しなさい。", a:"4", steps:"(-2)×(-2)=4。負の数の偶数回の積は正になる。"},
{id:127, ch:1, lv:2, sub:"乗法と除法", type:"rv", q:"-2の2乗(2だけを2乗する)を計算しなさい。", a:"-4", steps:"-2²は「2を2乗してからマイナスをつける」という意味。(-2)²とは違うので注意!2×2=4にマイナスをつけて-4。"},
{id:128, ch:1, lv:1, sub:"乗法と除法", type:"rv", q:"12を素因数分解しなさい。", a:"2×2×3", steps:"小さい素数から順に割っていく。12=2×6=2×2×3。"},
{id:129, ch:1, lv:2, sub:"乗法と除法", type:"in", q:"(-4)×(-3)×(-2) を計算しなさい。", a:"-24", ph:"数値を入力(マイナスは-を使う)", steps:"負の数が3個(奇数個)あるので積は負になる。4×3×2=24なので-24。"},
{id:130, ch:1, lv:2, sub:"乗法と除法", type:"in", q:"(-36)÷9×(-2) を計算しなさい。", a:"8", ph:"数値を入力(マイナスは-を使う)", steps:"左から順に計算する。-36÷9=-4、-4×(-2)=8。"},

// ---------- 第1章 4. 正負の数の利用 ----------
{id:131, ch:1, lv:1, sub:"正負の数の利用", type:"in", q:"ある日の最高気温は7℃、最低気温は-3℃でした。気温の差は何℃ですか。", a:"10", ph:"数値を入力(マイナスは-を使う)", steps:"差は大きい数から小さい数を引く。7-(-3)=7+3=10(℃)。"},
{id:132, ch:1, lv:1, sub:"正負の数の利用", type:"in", q:"Aさんの身長160cmを基準にすると、Bさんは+5cm、Cさんは-8cmです。Cさんの身長は何cmですか。", a:"152", ph:"数値を入力(マイナスは-を使う)", steps:"基準160cmに差をたす。160+(-8)=152(cm)。"},
{id:133, ch:1, lv:1, sub:"正負の数の利用", type:"in", q:"標高0mを基準として、A地点は+120m、B地点は-35mです。2地点の標高差は何mですか。", a:"155", ph:"数値を入力(マイナスは-を使う)", steps:"高い方から低い方を引く。120-(-35)=120+35=155(m)。"},
{id:134, ch:1, lv:1, sub:"正負の数の利用", type:"in", q:"ある商品の基準の重さを500gとし、実際との差を測ったところ-12gでした。実際の重さは何gですか。", a:"488", ph:"数値を入力(マイナスは-を使う)", steps:"基準500gに差をたす。500+(-12)=488(g)。"},
{id:135, ch:1, lv:2, sub:"正負の数の利用", type:"in", q:"月曜日の気温を基準(0)とし、火曜日は+3℃、水曜日は-2℃でした。火曜日と水曜日の気温差は何℃ですか。", a:"5", ph:"数値を入力(マイナスは-を使う)", steps:"3-(-2)=3+2=5(℃)。"},
{id:136, ch:1, lv:2, sub:"正負の数の利用", type:"in", q:"ある株価が月曜+200円、火曜-150円、水曜-80円変化しました。3日間の合計の変化は何円ですか。", a:"-30", ph:"数値を入力(マイナスは-を使う)", steps:"200+(-150)+(-80)=200-230=-30(円)。"},

// ---------- 第2章 1. 文字を使った式の表し方 ----------
{id:141, ch:2, lv:1, sub:"文字を使った式", type:"in", q:"xを5個と3をたした数を、文字式で表しなさい。", a:"5x+3", ph:"式の形で入力 例:7y-2", steps:"xが5個分なのでx×5=5x。数字は文字の前に書く。これに3をたすので5x+3。"},
{id:142, ch:2, lv:2, sub:"文字を使った式", type:"in", q:"xから4を引いた数を3倍した式を表しなさい。", a:"3(x-4)", ph:"式の形で入力 例:7y-2", steps:"「xから4を引いた数」は(x-4)。それを3倍するので3(x-4)。かっこを忘れないこと!"},
{id:143, ch:2, lv:1, sub:"文字を使った式", type:"in", q:"aの2倍からbをひいた数を式で表しなさい。", a:"2a-b", ph:"式の形で入力 例:7y-2", steps:"aの2倍は2a。そこからbをひくので2a-b。"},
{id:144, ch:2, lv:1, sub:"文字を使った式", type:"in", q:"xを7で割った数を式で表しなさい。", a:"x/7", ph:"分数の形(分子/分母)で入力 例:a/5", steps:"割る数は分母にする。x÷7はx/7と表す。"},
{id:145, ch:2, lv:1, sub:"文字を使った式", type:"in", q:"1個150円のりんごをx個買ったときの代金を式で表しなさい(円)。", a:"150x", ph:"式の形で入力 例:7y-2", steps:"1個150円がx個分なので150×x=150x(円)。"},
{id:146, ch:2, lv:2, sub:"文字を使った式", type:"in", q:"xにyをたしてから2をかけた式を表しなさい。", a:"2(x+y)", ph:"式の形で入力 例:7y-2", steps:"「xにyをたした数」は(x+y)。それに2をかけるので2(x+y)。"},
{id:147, ch:2, lv:2, sub:"文字を使った式", type:"in", q:"100円硬貨をa枚と50円硬貨をb枚持っているときの合計金額を式で表しなさい(円)。", a:"100a+50b", ph:"式の形で入力 例:7y-2", steps:"100円がa枚で100a円、50円がb枚で50b円。合計は100a+50b(円)。"},
{id:148, ch:2, lv:1, sub:"文字を使った式", type:"rv", q:"ある数xの2乗から3をひいた式を表しなさい。", a:"x²-3 (x^2-3)", steps:"xの2乗はx²。そこから3をひくのでx²-3。"},
{id:149, ch:2, lv:2, sub:"文字を使った式", type:"in", q:"1本80円のペンをx本と、1冊120円のノートをy冊買った合計金額を式で表しなさい(円)。", a:"80x+120y", ph:"式の形で入力 例:7y-2", steps:"ペンの代金80x円とノートの代金120y円を合わせる。80x+120y(円)。"},
{id:150, ch:2, lv:2, sub:"文字を使った式", type:"in", q:"xkmの道のりを時速4kmで歩いたときにかかる時間を式で表しなさい(時間)。", a:"x/4", ph:"分数の形(分子/分母)で入力 例:a/5", steps:"時間=道のり÷速さ。x÷4=x/4(時間)。"},

// ---------- 第2章 2. 式の値 ----------
{id:151, ch:2, lv:1, sub:"式の値", type:"in", q:"x=3 のとき、2x+5 の値を求めなさい。", a:"11", ph:"数値を入力(マイナスは-を使う)", steps:"xに3を代入する。2×3+5=6+5=11。"},
{id:152, ch:2, lv:1, sub:"式の値", type:"in", q:"x=-2 のとき、3x-4 の値を求めなさい。", a:"-10", ph:"数値を入力(マイナスは-を使う)", steps:"3×(-2)-4=-6-4=-10。"},
{id:153, ch:2, lv:1, sub:"式の値", type:"in", q:"a=4 のとき、a²の値を求めなさい。", a:"16", ph:"数値を入力(マイナスは-を使う)", steps:"4×4=16。"},
{id:154, ch:2, lv:1, sub:"式の値", type:"in", q:"x=-3 のとき、x²の値を求めなさい。", a:"9", ph:"数値を入力(マイナスは-を使う)", steps:"(-3)×(-3)=9。負の数の2乗は正になる。"},
{id:155, ch:2, lv:2, sub:"式の値", type:"in", q:"x=-3 のとき、-x²の値を求めなさい。", a:"-9", ph:"数値を入力(マイナスは-を使う)", steps:"-x²は「x²を求めてからマイナスをつける」という意味。x²=9なので、答えは-9。"},
{id:156, ch:2, lv:1, sub:"式の値", type:"in", q:"x=5 のとき、-2x+1 の値を求めなさい。", a:"-9", ph:"数値を入力(マイナスは-を使う)", steps:"-2×5+1=-10+1=-9。"},
{id:157, ch:2, lv:2, sub:"式の値", type:"in", q:"a=-2, b=3 のとき、a+2b の値を求めなさい。", a:"4", ph:"数値を入力(マイナスは-を使う)", steps:"-2+2×3=-2+6=4。"},
{id:158, ch:2, lv:1, sub:"式の値", type:"in", q:"x=-4 のとき、x/2+3 の値を求めなさい。", a:"1", ph:"数値を入力(マイナスは-を使う)", steps:"-4÷2+3=-2+3=1。"},

// ---------- 第2章 3. 項と係数、一次式の加法・減法 ----------
{id:161, ch:2, lv:1, sub:"項・係数・一次式の加減", type:"rv", q:"3x-7 の項をすべて答えなさい。", a:"3x と -7", steps:"項とは、式を+でつないだときの一つ一つのまとまり。3x-7=3x+(-7)なので、項は3xと-7。"},
{id:162, ch:2, lv:1, sub:"項・係数・一次式の加減", type:"in", q:"3x の係数を答えなさい。", a:"3", ph:"数値を入力(マイナスは-を使う)", steps:"係数とは、文字にかけられている数。3xの係数は3。"},
{id:163, ch:2, lv:1, sub:"項・係数・一次式の加減", type:"in", q:"-5x の係数を答えなさい。", a:"-5", ph:"数値を入力(マイナスは-を使う)", steps:"-5xの係数は-5(マイナスも含める)。"},
{id:164, ch:2, lv:1, sub:"項・係数・一次式の加減", type:"in", q:"(3x+2)+(5x-4) を計算しなさい。", a:"8x-2", ph:"式の形で入力 例:7y-2", steps:"文字の項どうし、数の項どうしをまとめる。3x+5x=8x、2-4=-2。よって8x-2。"},
{id:165, ch:2, lv:2, sub:"項・係数・一次式の加減", type:"in", q:"(4x-3)-(2x-6) を計算しなさい。", a:"2x+3", ph:"式の形で入力 例:7y-2", steps:"-( )の中の符号をすべて変える。-(2x-6)=-2x+6。4x-3-2x+6=2x+3。"},
{id:166, ch:2, lv:1, sub:"項・係数・一次式の加減", type:"in", q:"(-2x+5)+(3x-1) を計算しなさい。", a:"x+4", ph:"式の形で入力 例:7y-2", steps:"-2x+3x=x、5-1=4。よってx+4。"},
{id:167, ch:2, lv:2, sub:"項・係数・一次式の加減", type:"in", q:"(6x-2)-(6x-5) を計算しなさい。", a:"3", ph:"数値を入力(マイナスは-を使う)", steps:"6x-6x=0、-2-(-5)=-2+5=3。よって3。"},
{id:168, ch:2, lv:1, sub:"項・係数・一次式の加減", type:"in", q:"3x+4-x-7 を計算しなさい。", a:"2x-3", ph:"式の形で入力 例:7y-2", steps:"3x-x=2x、4-7=-3。よって2x-3。"},
{id:169, ch:2, lv:1, sub:"項・係数・一次式の加減", type:"in", q:"-x+2+5x-9 を計算しなさい。", a:"4x-7", ph:"式の形で入力 例:7y-2", steps:"-x+5x=4x、2-9=-7。よって4x-7。"},
{id:170, ch:2, lv:1, sub:"項・係数・一次式の加減", type:"in", q:"(2x-5)+(-3x+1) を計算しなさい。", a:"-x-4", ph:"式の形で入力 例:7y-2", steps:"2x-3x=-x、-5+1=-4。よって-x-4。"},

// ---------- 第2章 4. 一次式と数の乗法・除法 ----------
{id:171, ch:2, lv:1, sub:"一次式と数の乗除", type:"in", q:"3(2x-5) を計算しなさい。(かっこをはずす)", a:"6x-15", ph:"式の形で入力 例:7y-2", steps:"分配法則を使う。3×2x=6x、3×(-5)=-15。よって6x-15。"},
{id:172, ch:2, lv:2, sub:"一次式と数の乗除", type:"in", q:"-2(3x-4) を計算しなさい。", a:"-6x+8", ph:"式の形で入力 例:7y-2", steps:"-2×3x=-6x、-2×(-4)=8。よって-6x+8。"},
{id:173, ch:2, lv:1, sub:"一次式と数の乗除", type:"in", q:"(6x-9)÷3 を計算しなさい。", a:"2x-3", ph:"式の形で入力 例:7y-2", steps:"それぞれを3で割る。6x÷3=2x、-9÷3=-3。よって2x-3。"},
{id:174, ch:2, lv:1, sub:"一次式と数の乗除", type:"in", q:"(-12x+8)÷4 を計算しなさい。", a:"-3x+2", ph:"式の形で入力 例:7y-2", steps:"-12x÷4=-3x、8÷4=2。よって-3x+2。"},
{id:175, ch:2, lv:2, sub:"一次式と数の乗除", type:"in", q:"4(x-2)+3(x+1) を計算しなさい。", a:"7x-5", ph:"式の形で入力 例:7y-2", steps:"それぞれのかっこをはずす。4x-8+3x+3=7x-5。"},
{id:176, ch:2, lv:2, sub:"一次式と数の乗除", type:"in", q:"2(x+3)-(x-5) を計算しなさい。", a:"x+11", ph:"式の形で入力 例:7y-2", steps:"2x+6-x+5=x+11。"},
{id:177, ch:2, lv:2, sub:"一次式と数の乗除", type:"in", q:"-3(2x-1)+4 を計算しなさい。", a:"-6x+7", ph:"式の形で入力 例:7y-2", steps:"-6x+3+4=-6x+7。"},
{id:178, ch:2, lv:1, sub:"一次式と数の乗除", type:"in", q:"(15x-10)÷5 を計算しなさい。", a:"3x-2", ph:"式の形で入力 例:7y-2", steps:"15x÷5=3x、-10÷5=-2。よって3x-2。"},

// ---------- 第3章 1. 方程式と解・等式の性質 ----------
{id:181, ch:3, lv:1, sub:"方程式と解・等式の性質", type:"rv", q:"次のうち、x=3 が解であるものを選びなさい。\n① x+2=5　② 2x=4", a:"①", steps:"①にx=3を代入:3+2=5で成り立つ。②にx=3を代入:2×3=6で4にならない。よって①。"},
{id:182, ch:3, lv:1, sub:"方程式と解・等式の性質", type:"rv", q:"「方程式」とは何か、簡単に説明しなさい。", a:"文字の値によって成り立つかどうかが決まる等式", steps:"例えばx+1=4はx=3のときだけ成り立つ。このような等式を方程式という。x=3のような、方程式を成り立たせる値を「解」という。"},
{id:183, ch:3, lv:1, sub:"方程式と解・等式の性質", type:"rv", q:"等式の性質を1つ説明しなさい(両辺に同じ数をたす場合)。", a:"等式の両辺に同じ数をたしても、等式は成り立つ", steps:"A=BならばA+C=B+Cが成り立つ。同じように、両辺から同じ数をひいたり、同じ数をかけたり(0でない数で)わったりしても等式は成り立つ。"},
{id:184, ch:3, lv:1, sub:"方程式と解・等式の性質", type:"in", q:"x+5=8 の解を求めなさい。", a:"x=3", ph:"x=◯ の形で入力", steps:"両辺から5をひく。x=8-5=3。"},
{id:185, ch:3, lv:1, sub:"方程式と解・等式の性質", type:"in", q:"x-4=2 の解を求めなさい。", a:"x=6", ph:"x=◯ の形で入力", steps:"両辺に4をたす。x=2+4=6。"},
{id:186, ch:3, lv:1, sub:"方程式と解・等式の性質", type:"in", q:"3x=12 の解を求めなさい。", a:"x=4", ph:"x=◯ の形で入力", steps:"両辺を3でわる。x=12÷3=4。"},
{id:187, ch:3, lv:1, sub:"方程式と解・等式の性質", type:"in", q:"x/4=3 の解を求めなさい。", a:"x=12", ph:"x=◯ の形で入力", steps:"両辺に4をかける。x=3×4=12。"},
{id:188, ch:3, lv:1, sub:"方程式と解・等式の性質", type:"in", q:"-2x=10 の解を求めなさい。", a:"x=-5", ph:"x=◯ の形で入力", steps:"両辺を-2でわる。x=10÷(-2)=-5。"},

// ---------- 第3章 2. 方程式の解き方(移項) ----------
{id:191, ch:3, lv:1, sub:"方程式の解き方(移項)", type:"in", q:"2x+3=9 を解きなさい。", a:"x=3", ph:"x=◯ の形で入力", steps:"3を右辺に移項(符号を変えて移す)。2x=9-3=6。両辺を2でわる。x=3。"},
{id:192, ch:3, lv:1, sub:"方程式の解き方(移項)", type:"in", q:"3x-5=10 を解きなさい。", a:"x=5", ph:"x=◯ の形で入力", steps:"-5を右辺に移項。3x=10+5=15。両辺を3でわる。x=5。"},
{id:193, ch:3, lv:2, sub:"方程式の解き方(移項)", type:"in", q:"5x+2=2x+8 を解きなさい。", a:"x=2", ph:"x=◯ の形で入力", steps:"2xを左辺に、2を右辺に移項。5x-2x=8-2。3x=6。x=2。"},
{id:194, ch:3, lv:2, sub:"方程式の解き方(移項)", type:"in", q:"4x-7=x+5 を解きなさい。", a:"x=4", ph:"x=◯ の形で入力", steps:"xを左辺に、-7を右辺に移項。4x-x=5+7。3x=12。x=4。"},
{id:195, ch:3, lv:2, sub:"方程式の解き方(移項)", type:"in", q:"6-2x=x+9 を解きなさい。", a:"x=-1", ph:"x=◯ の形で入力", steps:"-2xを右辺、9を左辺に移項。6-9=x+2x。-3=3x。x=-1。"},
{id:196, ch:3, lv:2, sub:"方程式の解き方(移項)", type:"in", q:"7x+1=3x-11 を解きなさい。", a:"x=-3", ph:"x=◯ の形で入力", steps:"3xを左辺、1を右辺に移項。7x-3x=-11-1。4x=-12。x=-3。"},
{id:197, ch:3, lv:2, sub:"方程式の解き方(移項)", type:"in", q:"2(x+3)=10 を解きなさい。", a:"x=2", ph:"x=◯ の形で入力", steps:"かっこをはずす。2x+6=10。6を移項。2x=4。x=2。"},
{id:198, ch:3, lv:2, sub:"方程式の解き方(移項)", type:"in", q:"3(x-2)=x+4 を解きなさい。", a:"x=5", ph:"x=◯ の形で入力", steps:"かっこをはずす。3x-6=x+4。移項して3x-x=4+6。2x=10。x=5。"},
{id:199, ch:3, lv:2, sub:"方程式の解き方(移項)", type:"in", q:"5x-3=2(x+3) を解きなさい。", a:"x=3", ph:"x=◯ の形で入力", steps:"右辺のかっこをはずす。5x-3=2x+6。移項して5x-2x=6+3。3x=9。x=3。"},
{id:200, ch:3, lv:2, sub:"方程式の解き方(移項)", type:"in", q:"4(x+1)=2(x+5) を解きなさい。", a:"x=3", ph:"x=◯ の形で入力", steps:"両辺のかっこをはずす。4x+4=2x+10。移項して4x-2x=10-4。2x=6。x=3。"},

// ---------- 第3章 3. いろいろな方程式(小数・分数) ----------
{id:201, ch:3, lv:1, sub:"いろいろな方程式", type:"in", q:"0.2x=4 を解きなさい。", a:"x=20", ph:"x=◯ の形で入力", steps:"両辺を10倍して整数にする。2x=40。x=20。"},
{id:202, ch:3, lv:2, sub:"いろいろな方程式", type:"in", q:"0.3x-1=0.5 を解きなさい。", a:"x=5", ph:"x=◯ の形で入力", steps:"両辺を10倍。3x-10=5。移項して3x=15。x=5。"},
{id:203, ch:3, lv:1, sub:"いろいろな方程式", type:"in", q:"x/2+1=4 を解きなさい。", a:"x=6", ph:"x=◯ の形で入力", steps:"両辺を2倍して分母をはらう。x+2=8。移項してx=6。"},
{id:204, ch:3, lv:1, sub:"いろいろな方程式", type:"in", q:"x/3-2=1 を解きなさい。", a:"x=9", ph:"x=◯ の形で入力", steps:"両辺を3倍。x-6=3。移項してx=9。"},
{id:205, ch:3, lv:2, sub:"いろいろな方程式", type:"in", q:"x/2=x/3+1 を解きなさい。", a:"x=6", ph:"x=◯ の形で入力", steps:"両辺を6倍(2と3の最小公倍数)。3x=2x+6。移項してx=6。"},
{id:206, ch:3, lv:2, sub:"いろいろな方程式", type:"in", q:"0.5x+0.4=1.4 を解きなさい。", a:"x=2", ph:"x=◯ の形で入力", steps:"両辺を10倍。5x+4=14。移項して5x=10。x=2。"},
{id:207, ch:3, lv:1, sub:"いろいろな方程式", type:"in", q:"(x+1)/2=3 を解きなさい。", a:"x=5", ph:"x=◯ の形で入力", steps:"両辺を2倍。x+1=6。移項してx=5。"},
{id:208, ch:3, lv:1, sub:"いろいろな方程式", type:"in", q:"(x-2)/3=2 を解きなさい。", a:"x=8", ph:"x=◯ の形で入力", steps:"両辺を3倍。x-2=6。移項してx=8。"},
