// ---------- 第1章 1. 正の数・負の数の意味(追加) ----------
{id:301, ch:1, lv:1, sub:"数の大小・絶対値", type:"in", q:"+9 の絶対値を答えなさい。", a:"9", ph:"数値を入力(マイナスは-を使う)", steps:"絶対値とは0からの距離。+9と0の距離は9なので絶対値は9。"},
{id:302, ch:1, lv:1, sub:"数の大小・絶対値", type:"in", q:"絶対値が6である数のうち、正の数を答えなさい。", a:"6", ph:"数値を入力(マイナスは-を使う)", steps:"絶対値が6になる数は+6と-6。正の数なので+6。"},
{id:303, ch:1, lv:2, sub:"数の大小・絶対値", type:"in", q:"次の数の中で2番目に大きい数を答えなさい。\n-5, 3, -1, 4", a:"3", ph:"数値を入力(マイナスは-を使う)", steps:"大きい順に並べると4, 3, -1, -5。2番目に大きいのは3。"},
{id:304, ch:1, lv:2, sub:"数の大小・絶対値", type:"in", q:"次の数の中で絶対値が最も小さい数を答えなさい。\n-6, 2, -3, 5", a:"2", ph:"数値を入力(マイナスは-を使う)", steps:"各数の絶対値は6,2,3,5。最も小さいのは2の絶対値2。"},
{id:305, ch:1, lv:1, sub:"数の大小・絶対値", type:"in", q:"-4 と -1 のうち、小さい方の数を答えなさい。", a:"-4", ph:"数値を入力(マイナスは-を使う)", steps:"負の数では絶対値が大きいほど小さい。4>1なので-4の方が小さい。"},
{id:306, ch:1, lv:1, sub:"数の大小・絶対値", type:"in", q:"0 より 8 大きい数を答えなさい。", a:"8", ph:"数値を入力(マイナスは-を使う)", steps:"0から8大きい数は0+8=8。"},
{id:307, ch:1, lv:2, sub:"数の大小・絶対値", type:"in", q:"絶対値が7より小さい整数のうち、最も小さいものを答えなさい。", a:"-6", ph:"数値を入力(マイナスは-を使う)", steps:"絶対値が7より小さい整数は-6から6まで。最も小さいのは-6。"},
{id:308, ch:1, lv:1, sub:"数の大小・絶対値", type:"in", q:"-2.8 の絶対値を答えなさい。", a:"2.8", ph:"数値を入力(マイナスは-を使う)", steps:"-2.8と0の距離は2.8。よって絶対値は2.8。"},
{id:309, ch:1, lv:2, sub:"数の大小・絶対値", type:"in", q:"次の数を大きい順に並べたとき、3番目になる数を答えなさい。\n-7, 1, -3, 6", a:"-3", ph:"数値を入力(マイナスは-を使う)", steps:"大きい順:6,1,-3,-7。3番目は-3。"},

// ---------- 第1章 2. 加法と減法(追加) ----------
{id:311, ch:1, lv:1, sub:"加法と減法", type:"in", q:"(+8)+(+2) を計算しなさい。", a:"10", ph:"数値を入力(マイナスは-を使う)", steps:"同符号の加法は絶対値の和に共通の符号をつける。8+2=10、符号は+。"},
{id:312, ch:1, lv:1, sub:"加法と減法", type:"in", q:"(-9)+(-3) を計算しなさい。", a:"-12", ph:"数値を入力(マイナスは-を使う)", steps:"同符号の加法。9+3=12、符号は-。よって-12。"},
{id:313, ch:1, lv:1, sub:"加法と減法", type:"in", q:"(+5)+(-12) を計算しなさい。", a:"-7", ph:"数値を入力(マイナスは-を使う)", steps:"異符号の加法は絶対値の差に絶対値が大きい方の符号。12-5=7、絶対値が大きいのは-12なので-7。"},
{id:314, ch:1, lv:1, sub:"加法と減法", type:"in", q:"(-8)+(+15) を計算しなさい。", a:"7", ph:"数値を入力(マイナスは-を使う)", steps:"異符号の加法。15-8=7、絶対値が大きいのは+15なので+7。"},
{id:315, ch:1, lv:2, sub:"加法と減法", type:"in", q:"(-6)-(-10) を計算しなさい。", a:"4", ph:"数値を入力(マイナスは-を使う)", steps:"引くことは符号を変えて加えること。-6-(-10)=-6+10=4。"},
{id:316, ch:1, lv:1, sub:"加法と減法", type:"in", q:"(+4)-(+9) を計算しなさい。", a:"-5", ph:"数値を入力(マイナスは-を使う)", steps:"+4-(+9)=+4-9=-5。"},
{id:317, ch:1, lv:2, sub:"加法と減法", type:"in", q:"(+3)-(-8) を計算しなさい。", a:"11", ph:"数値を入力(マイナスは-を使う)", steps:"+3-(-8)=+3+8=11。"},
{id:318, ch:1, lv:2, sub:"加法と減法", type:"in", q:"-5+9-7 を計算しなさい。", a:"-3", ph:"数値を入力(マイナスは-を使う)", steps:"左から計算する。-5+9=4、4-7=-3。"},
{id:319, ch:1, lv:2, sub:"加法と減法", type:"in", q:"7-(-2)+(-10) を計算しなさい。", a:"-1", ph:"数値を入力(マイナスは-を使う)", steps:"7-(-2)=7+2=9。9+(-10)=-1。"},

// ---------- 第1章 3. 乗法と除法(追加) ----------
{id:321, ch:1, lv:1, sub:"乗法と除法", type:"in", q:"(-5)×(+3) を計算しなさい。", a:"-15", ph:"数値を入力(マイナスは-を使う)", steps:"異符号の積は負。5×3=15なので-15。"},
{id:322, ch:1, lv:1, sub:"乗法と除法", type:"in", q:"(-7)×(-4) を計算しなさい。", a:"28", ph:"数値を入力(マイナスは-を使う)", steps:"同符号の積は正。7×4=28。"},
{id:323, ch:1, lv:1, sub:"乗法と除法", type:"in", q:"(+18)÷(-3) を計算しなさい。", a:"-6", ph:"数値を入力(マイナスは-を使う)", steps:"異符号の商は負。18÷3=6なので-6。"},
{id:324, ch:1, lv:1, sub:"乗法と除法", type:"in", q:"(-24)÷(-6) を計算しなさい。", a:"4", ph:"数値を入力(マイナスは-を使う)", steps:"同符号の商は正。24÷6=4。"},
{id:325, ch:1, lv:2, sub:"乗法と除法", type:"in", q:"(-3)^3 を計算しなさい。", a:"-27", ph:"数値を入力(マイナスは-を使う)", steps:"(-3)を3回かける。(-3)×(-3)×(-3)=9×(-3)=-27。奇数回かけると負になる。"},
{id:326, ch:1, lv:1, sub:"乗法と除法", type:"in", q:"(-4)^2 を計算しなさい。", a:"16", ph:"数値を入力(マイナスは-を使う)", steps:"(-4)×(-4)=16。偶数回かけると正になる。"},
{id:327, ch:1, lv:2, sub:"乗法と除法", type:"in", q:"-3^2 を計算しなさい。", a:"-9", ph:"数値を入力(マイナスは-を使う)", steps:"指数は3だけにかかるので、-(3×3)=-9。-3を2乗するわけではない点に注意。"},
{id:328, ch:1, lv:1, sub:"乗法と除法", type:"in", q:"18 を素因数分解しなさい。", a:"2×3×3", ph:"例: 2×3×3", steps:"18=2×9=2×3×3。"},
{id:329, ch:1, lv:2, sub:"乗法と除法", type:"in", q:"(-2)×(-5)×(-3) を計算しなさい。", a:"-30", ph:"数値を入力(マイナスは-を使う)", steps:"負の数を3個(奇数個)かけているので結果は負。2×5×3=30なので-30。"},

// ---------- 第1章 4. 正負の数の利用(追加) ----------
{id:331, ch:1, lv:1, sub:"正負の数の利用", type:"in", q:"ある日の最高気温は7℃、最低気温は-3℃でした。この日の気温差は何℃ですか。", a:"10", ph:"数値を入力", steps:"気温差=最高-最低=7-(-3)=10。"},
{id:332, ch:1, lv:1, sub:"正負の数の利用", type:"in", q:"Aさんの身長は160cmを基準にして+5cmです。Aさんの身長は何cmですか。", a:"165", ph:"数値を入力", steps:"160+5=165(cm)。"},
{id:333, ch:1, lv:1, sub:"正負の数の利用", type:"in", q:"ある山の山頂の標高は2400m、ふもとの標高は600mです。標高差は何mですか。", a:"1800", ph:"数値を入力", steps:"2400-600=1800(m)。"},
{id:334, ch:1, lv:1, sub:"正負の数の利用", type:"in", q:"ある荷物の重さは、基準の5kgに対して-1.5kgでした。実際の重さは何kgですか。", a:"3.5", ph:"数値を入力", steps:"5+(-1.5)=3.5(kg)。"},
{id:335, ch:1, lv:2, sub:"正負の数の利用", type:"in", q:"月曜の気温は基準より+3℃、火曜は基準より-5℃でした。火曜は月曜より何℃低いですか。", a:"8", ph:"数値を入力", steps:"月曜と火曜の差=(+3)-(-5)=3+5=8(℃)。"},
{id:336, ch:1, lv:2, sub:"正負の数の利用", type:"in", q:"ある会社の株価が1日目+200円、2日目-350円、3日目+80円変化しました。3日間の合計の変化は何円ですか。", a:"-70", ph:"数値を入力(マイナスは-を使う)", steps:"200+(-350)+80=-70(円)。"},
{id:337, ch:1, lv:1, sub:"正負の数の利用", type:"in", q:"基準の体重60kgに対して-3kgの人の体重は何kgですか。", a:"57", ph:"数値を入力", steps:"60+(-3)=57(kg)。"},
{id:338, ch:1, lv:2, sub:"正負の数の利用", type:"in", q:"Bさんの得点は基準点より+12点、Cさんは基準点より-8点でした。BさんはCさんより何点高いですか。", a:"20", ph:"数値を入力", steps:"BとCの差=(+12)-(-8)=12+8=20(点)。"},
{id:339, ch:1, lv:1, sub:"正負の数の利用", type:"in", q:"ある日の朝の気温は-2℃で、昼には朝より6℃上がりました。昼の気温は何℃ですか。", a:"4", ph:"数値を入力(マイナスは-を使う)", steps:"-2+6=4(℃)。"},

// ---------- 第2章 1. 文字を使った式(追加) ----------
{id:401, ch:2, lv:1, sub:"文字を使った式", type:"in", q:"xを4倍して7を加えた数を、xを使った式で表しなさい。", a:"4x+7", ph:"例: 4x+7", steps:"xを4倍するのは4x、それに7を加えるので4x+7。"},
{id:402, ch:2, lv:2, sub:"文字を使った式", type:"in", q:"xから5をひいた数を3倍した数を、xを使った式で表しなさい。", a:"3(x-5)", ph:"例: 3(x-5)", steps:"xから5をひく→x-5。それを3倍するのでかっこをつけて3(x-5)。"},
{id:403, ch:2, lv:1, sub:"文字を使った式", type:"in", q:"aを2倍した数からbをひいた数を、文字式で表しなさい。", a:"2a-b", ph:"例: 2a-b", steps:"aを2倍は2a、そこからbをひくので2a-b。"},
{id:404, ch:2, lv:1, sub:"文字を使った式", type:"in", q:"yを9で割った数を、文字式で表しなさい。", a:"y/9", ph:"例: y/9", steps:"yを9で割るのでy/9(分数の形)。"},
{id:405, ch:2, lv:1, sub:"文字を使った式", type:"in", q:"1個200円のりんごをx個買ったときの代金を、文字式で表しなさい。", a:"200x", ph:"例: 200x", steps:"1個200円をx個買うので200×x=200x。"},
{id:406, ch:2, lv:2, sub:"文字を使った式", type:"in", q:"xとyの和を2倍した数を、文字式で表しなさい。", a:"2(x+y)", ph:"例: 2(x+y)", steps:"xとyの和はx+y。それを2倍するのでかっこをつけて2(x+y)。"},
{id:407, ch:2, lv:2, sub:"文字を使った式", type:"in", q:"1本150円のペンをa本、1個90円の消しゴムをb個買ったときの代金の合計を、文字式で表しなさい。", a:"150a+90b", ph:"例: 150a+90b", steps:"ペンの代金150a、消しゴムの代金90bを合わせて150a+90b。"},
{id:408, ch:2, lv:1, sub:"文字を使った式", type:"in", q:"xを2乗した数から7をひいた数を、文字式で表しなさい。", a:"x^2-7", ph:"例: x^2-7", steps:"xを2乗はx^2、そこから7をひくのでx^2-7。"},
{id:409, ch:2, lv:2, sub:"文字を使った式", type:"in", q:"akmの道のりを時速4kmで歩くときにかかる時間を、文字式で表しなさい。", a:"a/4", ph:"例: a/4", steps:"時間=道のり÷速さ。a÷4=a/4(時間)。"},

// ---------- 第2章 2. 式の値(追加) ----------
{id:411, ch:2, lv:1, sub:"式の値", type:"in", q:"x=4のとき、3x+2 の値を求めなさい。", a:"14", ph:"数値を入力(マイナスは-を使う)", steps:"3×4+2=12+2=14。"},
{id:412, ch:2, lv:1, sub:"式の値", type:"in", q:"x=-3のとき、2x-5 の値を求めなさい。", a:"-11", ph:"数値を入力(マイナスは-を使う)", steps:"2×(-3)-5=-6-5=-11。"},
{id:413, ch:2, lv:1, sub:"式の値", type:"in", q:"a=5のとき、a^2 の値を求めなさい。", a:"25", ph:"数値を入力(マイナスは-を使う)", steps:"5×5=25。"},
{id:414, ch:2, lv:1, sub:"式の値", type:"in", q:"x=-2のとき、x^2 の値を求めなさい。", a:"4", ph:"数値を入力(マイナスは-を使う)", steps:"(-2)×(-2)=4。負の数の2乗は正になる。"},
{id:415, ch:2, lv:2, sub:"式の値", type:"in", q:"x=-2のとき、-x^2 の値を求めなさい。", a:"-4", ph:"数値を入力(マイナスは-を使う)", steps:"x^2=(-2)^2=4。マイナスは最後につけるので-x^2=-4。"},
{id:416, ch:2, lv:1, sub:"式の値", type:"in", q:"x=6のとき、-3x+4 の値を求めなさい。", a:"-14", ph:"数値を入力(マイナスは-を使う)", steps:"-3×6+4=-18+4=-14。"},
{id:417, ch:2, lv:2, sub:"式の値", type:"in", q:"a=3, b=-2のとき、2a+3b の値を求めなさい。", a:"0", ph:"数値を入力(マイナスは-を使う)", steps:"2×3+3×(-2)=6-6=0。"},
{id:418, ch:2, lv:1, sub:"式の値", type:"in", q:"x=-6のとき、x/3+1 の値を求めなさい。", a:"-1", ph:"数値を入力(マイナスは-を使う)", steps:"-6/3+1=-2+1=-1。"},
{id:419, ch:2, lv:2, sub:"式の値", type:"in", q:"x=-4のとき、x^2-2x の値を求めなさい。", a:"24", ph:"数値を入力(マイナスは-を使う)", steps:"x^2=(-4)^2=16。2x=2×(-4)=-8。16-(-8)=16+8=24。"},

// ---------- 第2章 3. 項・係数・一次式の加減(追加) ----------
{id:421, ch:2, lv:1, sub:"項・係数・一次式の加減", type:"in", q:"4x-7 の項を答えなさい。", a:"4x,-7", ph:"例: 4x,-7", steps:"加法だけの形に直すと4x+(-7)。項は4xと-7。"},
{id:422, ch:2, lv:1, sub:"項・係数・一次式の加減", type:"in", q:"-6x の係数を答えなさい。", a:"-6", ph:"数値を入力(マイナスは-を使う)", steps:"文字の前についている数が係数。-6x の係数は-6。"},
{id:423, ch:2, lv:1, sub:"項・係数・一次式の加減", type:"in", q:"x の係数を答えなさい。", a:"1", ph:"数値を入力", steps:"xは1×xと考えられるので係数は1。"},
{id:424, ch:2, lv:1, sub:"項・係数・一次式の加減", type:"in", q:"(2x+5)+(4x-3) を計算しなさい。", a:"6x+2", ph:"例: 6x+2", steps:"xの項どうし、数の項どうしをまとめる。2x+4x=6x、5+(-3)=2。よって6x+2。"},
{id:425, ch:2, lv:2, sub:"項・係数・一次式の加減", type:"in", q:"(5x-2)-(3x-8) を計算しなさい。", a:"2x+6", ph:"例: 2x+6", steps:"ひくときはかっこの中の符号を変えて加える。5x-2-3x+8=2x+6。"},
{id:426, ch:2, lv:1, sub:"項・係数・一次式の加減", type:"in", q:"(-3x+4)+(2x-9) を計算しなさい。", a:"-x-5", ph:"例: -x-5", steps:"-3x+2x=-x、4+(-9)=-5。よって-x-5。"},
{id:427, ch:2, lv:2, sub:"項・係数・一次式の加減", type:"in", q:"(4x-1)-(4x-7) を計算しなさい。", a:"6", ph:"数値を入力", steps:"4x-1-4x+7=6。xの項が消えて数だけ残る。"},
{id:428, ch:2, lv:1, sub:"項・係数・一次式の加減", type:"in", q:"5x-2-2x+8 を計算しなさい。", a:"3x+6", ph:"例: 3x+6", steps:"5x-2x=3x、-2+8=6。よって3x+6。"},
